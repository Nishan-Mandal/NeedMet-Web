{
  "functions": [
    {
      "source": "functions",
      "codebase": "share-preview",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap*.xml",
        "function": "sitemap"
      },
      {
        "source": "/listing/**",
        "function": "shareListing"
      },
      {
        "source": "/blog/**",
        "function": "shareArticle"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
